FROM node:20-alpine
WORKDIR /app

# Копируем package файлы
COPY package.json package-lock.json* ./
RUN npm ci

# Копируем весь проект
COPY . .

# Устанавливаем переменные окружения
ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1

# Экспонируем порт
EXPOSE 3000

# Запуск в dev режиме
CMD ["npm", "run", "dev"]